# Copy to .env and uncomment one block.
# Defaults: ROS_DOMAIN_ID=25, RMW=FastDDS (matches OutdoorNav + ROS 2 Jazzy default).

# ROS_DOMAIN_ID=25

# --- FastDDS (default; nothing to do unless you have a profile XML) ---
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Drop your profile in docker/ and reference it via the repo mount:
# FASTRTPS_DEFAULT_PROFILES_FILE=/repo/docker/fastdds_profile.xml

# --- CycloneDDS (uses docker/cyclonedds.xml — edit NetworkInterface first) ---
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# CYCLONEDDS_URI=file:///cyclonedds.xml

# --- Zenoh ---
# Needs rmw_zenoh installed in the base image; not bundled here.
# RMW_IMPLEMENTATION=rmw_zenoh_cpp
# ZENOH_CONFIG_OVERRIDE=mode=client;connect/endpoints=[\"tcp/10.0.0.35:7447\"]
