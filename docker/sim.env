# Transport profile: SIM (onav-lab Gazebo / lightweight sim).
# Use:  docker compose --env-file sim.env run --rm dev
#
# CycloneDDS multicast on domain 25, namespace /a300_00003.
ROS_DOMAIN_ID=25
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///cyclonedds.xml
ONAV_NAMESPACE=/a300_00003
# Edit docker/cyclonedds.xml's <NetworkInterface> to the interface that reaches the sim host.
