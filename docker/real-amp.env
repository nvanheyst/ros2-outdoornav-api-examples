# Transport profile: REAL amp (cpr-a300-00070) and other real OutdoorNav robots.
# Use:  docker compose --env-file real-amp.env run --rm dev
#
# Fast DDS + the robot's Discovery Server (super-client). RUN THIS ON THE ROBOT - the
# discovery server is on the robot's loopback. Off-robot needs a bridge (e.g. a Zenoh
# router); a Cloudflare TCP tunnel is NOT allowed (ToS).
#
# DOMAIN IS PER-ROBOT: read system.ros2.domain_id from /etc/clearpath/robot.yaml.
# amp cpr-a300-00070 = 0; cpr-a300-00003 = 20. Override ROS_DOMAIN_ID to match your unit.
# (Some robots also set a FastDDS profile xml under system.ros2.middleware.profile.)
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_DISCOVERY_SERVER=127.0.0.1:11811
ROS_SUPER_CLIENT=TRUE
# UDP-only transport. The container can't share the host's Fast DDS shared-memory
# segments, so large samples (pointclouds, images, costmaps) never arrive over SHM
# while small ones sneak through on UDP. Forcing UDP delivers everything. Compose mounts
# this profile at /fastdds_udp_only.xml (alongside /cyclonedds.xml). See the file's
# header for the full rationale.
FASTRTPS_DEFAULT_PROFILES_FILE=/fastdds_udp_only.xml
# Robot namespace. Must be set - empty falls back to the compose default
# /a300_00003 (wrong robot). Pinned to the marketing amp here.
ONAV_NAMESPACE=/a300_00070
